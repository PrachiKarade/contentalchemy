# Secrets: API keys (OpenAI, Anthropic, Gemini, Perplexity, SerpApi, Tavily,
# Stability, LangSmith), MongoDB URI and storage keys. Keep the template.
# .env.* also covers per-environment files such as .env.development / .env.production.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Virtual environments
.venv/
venv/
env/

# Python bytecode and build output
__pycache__/
*.py[cod]
*.pyc.*
*.egg-info/
build/
dist/

# Tests and tooling caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Logs
logs/
*.log

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated artifacts (local image storage fallback)
generated/

# Docker: personal overrides of docker-compose.yml
docker-compose.override.yml

# MongoDB backups (mongodump, see docs/deployment-guide.md)
dump/
*.archive

# Azurite data when run outside Docker (npm / VS Code extension)
__azurite_db_*.json
__blobstorage__/
__queuestorage__/
