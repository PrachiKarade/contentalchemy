OPENAI_API_KEY = your_openai_api_key_here



DEFAULT_MODEL = "gpt-4o-mini"

SERPAPI_KEY = your_serpapi_api_key_here

# Claude 
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_DEFAULT_MODEL=claude-sonnet-5-5

# Perplexity
PERPLEXITY_API_KEY=...
PERPLEXITY_DEFAULT_MODEL=perplexity/sonar

# Gemini 
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

TEXT_PRIMARY_PROVIDER=openai
TEXT_FALLBACK_PROVIDERS=claude,gemini,perplexity

# Image generation settings

STABILITY_API_KEY  = your_stability_api_key_here

STABILITY_IMAGE_MODEL=core
IMAGE_TIMEOUT_SECONDS=120


IMAGE_PRIMARY_PROVIDER = stability
IMAGE_FALLBACK_PROVIDERS =openai,gemini

STABILITY_IMAGE_ENABLED = true
OPENAI_IMAGE_ENABLED    = false
GEMINI_IMAGE_ENABLED    = false

IMAGE_PROVIDER = gemini
IMAGE_MODEL = gemini-3.1-flash-lite-image

# azure blob storage
AZURITE_ACCOUNT_NAME=azurite_devstoreaccount1
AZURITE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
AZURITE_CONTAINER_NAME=azure-blob-container
AZURITE_ACCOUNT_KEY=azurite_devstoreaccount1_key

# MongoDB

MONGODB_URI = mongodb://127.0.0.1:27017
MONGODB_DATABASE = contentalchemy_db

# LangSmith
LANGCHAIN_TRACING_V2 = true
LANGCHAIN_API_KEY = langsmith_api_key_here
LANGCHAIN_PROJECT = contentalchemy