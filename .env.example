# Copy this file to .env and fill in your own keys. Never commit .env.

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_MODEL=gpt-4o-mini

# Research / search
SERPAPI_KEY=your_serpapi_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_DEFAULT_MODEL=claude-sonnet-5-5

# Perplexity
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_DEFAULT_MODEL=perplexity/sonar

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Text provider fallback order
TEXT_PRIMARY_PROVIDER=openai
TEXT_FALLBACK_PROVIDERS=claude,gemini,perplexity

# Image generation settings
STABILITY_API_KEY=your_stability_api_key_here
STABILITY_IMAGE_MODEL=core
IMAGE_TIMEOUT_SECONDS=120

IMAGE_PRIMARY_PROVIDER=stability
IMAGE_FALLBACK_PROVIDERS=openai,gemini

OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

STABILITY_IMAGE_ENABLED=true
OPENAI_IMAGE_ENABLED=true
GEMINI_IMAGE_ENABLED=true

IMAGE_PROVIDER=gemini
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Azure Blob Storage (Azurite local emulator defaults)
AZURITE_ACCOUNT_NAME=your_azurite_account_name
AZURITE_BLOB_ENDPOINT=http://127.0.0.1:10000/your_azurite_account_name
AZURITE_CONTAINER_NAME=your_container_name
AZURITE_ACCOUNT_KEY=your_azurite_account_key

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=contentalchemy_db

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=contentalchemy
